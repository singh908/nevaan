package com.bnpparibas.mrx.be.dwl.config;

import org.apache.commons.dbcp2.BasicDataSource;
import org.springframework.beans.factory.FactoryBean;
import org.springframework.beans.factory.InitializingBean;
import javax.sql.DataSource;
import java.io.File;
import java.net.URL;
import java.net.URLClassLoader;

public class KineticaDataSourceFactory 
       implements FactoryBean<DataSource>, InitializingBean {

    private String driverJarPath;   // path to kinetica-jdbc jar
    private String gpudbJarPath;    // path to gpudb-api jar
    private String jdbcUrl;
    private String username;
    private String password;
    private int    maxTotal = 5;

    private DataSource dataSource;

    @Override
    public void afterPropertiesSet() throws Exception {
        // Load Kinetica in an isolated classloader
        // completely separate from the main application classloader
        URLClassLoader isolated = new URLClassLoader(
            new URL[]{
                new File(driverJarPath).toURI().toURL(),
                new File(gpudbJarPath).toURI().toURL()
            },
            ClassLoader.getPlatformClassLoader()  // NOT app classloader
        );

        // Register driver manually through isolated loader
        java.sql.Driver driver = (java.sql.Driver)
            Class.forName("com.kinetica.jdbc.Driver", true, isolated)
                 .getDeclaredConstructor()
                 .newInstance();

        // Create DBCP2 pool with the isolated driver
        BasicDataSource ds = new BasicDataSource();
        ds.setDriver(driver);
        ds.setUrl(jdbcUrl);
        ds.setUsername(username);
        ds.setPassword(password);
        ds.setMaxTotal(maxTotal);
        ds.setMinIdle(1);

        this.dataSource = ds;
    }

    @Override
    public DataSource getObject() {
        return dataSource;
    }

    @Override
    public Class<?> getObjectType() {
        return DataSource.class;
    }

    @Override
    public boolean isSingleton() {
        return true;
    }

    // Setters
    public void setDriverJarPath(String v) { this.driverJarPath = v; }
    public void setGpudbJarPath(String v)  { this.gpudbJarPath  = v; }
    public void setJdbcUrl(String v)       { this.jdbcUrl       = v; }
    public void setUsername(String v)      { this.username      = v; }
    public void setPassword(String v)      { this.password      = v; }
    public void setMaxTotal(int v)         { this.maxTotal      = v; }
}
